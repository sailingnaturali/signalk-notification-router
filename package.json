    "test": "node --test",
    "inject": "node scripts/inject-test-notification.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-notifications",
    "notifications",
    "alarm",
    "mqtt",
    "telegram",
    "marine"
  ],
  "author": "Bryan Clark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailingnaturali/signalk-notification-router.git"
  },
  "homepage": "https://github.com/sailingnaturali/signalk-notification-router#readme",
  "bugs": {
    "url": "https://github.com/sailingnaturali/signalk-notification-router/issues"
  },
  "signalk": {
    "displayName": "Notification Router"
  },
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "files": [
    "index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ws": "^8.21.3"
